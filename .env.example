# ---------------------------------------------------------------
# NAS Anomaly Sentinel - copy to .env and edit
# ---------------------------------------------------------------

# Local time for logs, e-mails and the "same hour of day" baseline
TZ=Europe/Istanbul

# Watched shares, as name=/path/inside/container (mount them in docker-compose.yml)
WATCH_PATHS=demo=/watch/demo
# Folders to skip (NAS thumbnails, recycle bins, snapshots)
EXCLUDE_DIRS=@eaDir,@recycle,#recycle,.Trash-1000,.snapshot,@tmp,lost+found

# Scan every N seconds (300 recommended on a real NAS, 60 for the demo)
SCAN_INTERVAL=60
BASELINE_DAYS=30
MIN_BASELINE_DAYS=7
RETENTION_DAYS=35
Z_WARNING=4
Z_CRITICAL=8

# Alert language: tr | en
ALERT_LANG=tr
ALERT_COOLDOWN=1800

# Container metrics through the read-only socket proxy.
# (DOCKER_HOST is set inside docker-compose.yml on purpose: if it were here,
#  the `docker compose` CLI on the host would also try to use it.)
ENABLE_DOCKER_STATS=true

# ---- E-mail ----------------------------------------------------
# Demo: Mailpit catches every mail at http://<nas-ip>:8025
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nas-sentinel@home.lan
MAIL_TO=you@example.com
# Gmail example (use an App Password, not your real password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- Zabbix ----------------------------------------------------
# Turn on after Zabbix is running (docker compose --profile zabbix up -d)
ZABBIX_ENABLED=false
ZABBIX_SERVER=zabbix-server
ZABBIX_PORT=10051
# Must match the host name you create in Zabbix
ZABBIX_HOST=nas-sentinel

# ---- Zabbix demo stack (profile: zabbix) ------------------------
POSTGRES_PASSWORD=change-me-zabbix
